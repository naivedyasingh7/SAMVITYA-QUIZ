{
  "name": "event-points-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Unified 6-module event points management system with automated scoring and live leaderboard",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
