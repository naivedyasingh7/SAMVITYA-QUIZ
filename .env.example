# ===============================================
# Event Points Management System - Environment Config
# ===============================================

# Supabase API (Client-side)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Backend / Migration / Test use ONLY - DO NOT EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
VITE_APP_NAME="Event Points Management System"
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:5173/api

# Mock Provider Configuration
VITE_MOCK_QUIZ_DELAY_MS=1200
VITE_ENABLE_MOCK_DATA=true

# Admin Setup (For Initial Local Seeding)
INITIAL_ADMIN_EMAIL=admin@eventpoints.local
INITIAL_ADMIN_PASSWORD=AdminSecurePassword2026!
